# --- Runtime ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Local:   mongodb://127.0.0.1:27017/diu_student_hub
# Atlas:   mongodb+srv://<user>:<password>@<cluster>/diu_student_hub
MONGODB_URI=mongodb://127.0.0.1:27017/diu_student_hub

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS / cookies ---
# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173
# Public URL of the frontend (used in email links)
CLIENT_URL=http://localhost:5173
# "lax" when frontend and API share a site; "none" when they are on different sites (requires HTTPS)
COOKIE_SAMESITE=lax
# Set when the API sits behind a proxy (Render, Railway, Nginx)
TRUST_PROXY=0

# --- Deployment helpers ---
# Emails that become admins when they register/sign in (first-admin bootstrap). Comma-separated.
ADMIN_EMAILS=
# Shared secret for GET /api/v1/cron/reminders (Vercel Cron sends it automatically).
CRON_SECRET=
# Serve the built React app from this server (single-service hosting like Render). Run `npm run build` first.
SERVE_CLIENT=false
# Create starter departments when the database has none.
BOOTSTRAP_DEPARTMENTS=true

# --- File storage ---
# "local" = files on disk in UPLOAD_DIR; "gridfs" = files inside MongoDB (use on hosts without a persistent disk).
# Defaults to gridfs automatically on Vercel and Render.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# --- Moderation ---
# When true, academic resources stay hidden until a moderator approves them
RESOURCES_REQUIRE_APPROVAL=true

# --- Email (optional). Without SMTP, links are printed to the server console in development only. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DIU Student Hub <no-reply@example.com>"
