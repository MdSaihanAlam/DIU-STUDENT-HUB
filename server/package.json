{
  "name": "@diu-hub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=scripts src/server.js",
    "dev:mem": "node --watch-path=src --watch-path=scripts src/server.js --memory",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.0"
  }
}
