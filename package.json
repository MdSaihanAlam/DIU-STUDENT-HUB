{
  "name": "diu-student-hub",
  "version": "0.1.0",
  "private": true,
  "description": "DIU Student Hub — an independent community platform for the Dhaka International University community.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mem": "node scripts/dev.mjs --memory",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm test --workspace server",
    "lint": "npm run lint --workspace client"
  },
  "engines": {
    "node": ">=20"
  }
}
